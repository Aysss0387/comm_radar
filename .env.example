CONTACT_EMAIL=aiyushi0387@gmail.com
RESEND_API_KEY=re_replace_with_your_api_key
RESEND_FROM_EMAIL=Paper Radar <onboarding@resend.dev>

# Neon 持久化（Vercel 集成会自动注入；本地可选）
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Zotero Web API（发布环境的集合读取、PDF 下载与精读卡子 Note 写入通道）
# 在 https://www.zotero.org/settings/keys 创建带写权限（Allow write access）的 key
ZOTERO_USER_ID=replace_with_your_zotero_user_id
ZOTERO_API_KEY=replace_with_your_zotero_api_key

# 每日精读的 LLM 深度解读（OpenAI 兼容接口）
LLM_API_KEY=replace_with_your_llm_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 网页工作台的 AI 精读/比较（DeepSeek，服务端固定配置）
# 在 Vercel 项目 Settings → Environment Variables 中添加（Production + Preview），
# 保存后重新部署；配置一次后网页不再需要输入 API Key。
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
